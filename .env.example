# Dashboard runtime config. Copy to .env and edit.

# SQLite path, or a Postgres connection string (sqlalchemy URL).
DATABASE_URL=sqlite:///./data/dashboard.db

# Mark the session cookie Secure so browsers refuse to send it over HTTP.
# Set to 1 once nginx-TLS is in front. Leave blank for local backend dev.
SESSION_COOKIE_SECURE=

# Host's docker.sock GID — used by docker-compose to grant the non-root app
# user read access. Check with: stat -c '%g' /var/run/docker.sock
#   Raspberry Pi / Debian default: 999
#   macOS + colima: often 991
DOCKER_GID=999

# Gateway containers the monitor refuses to stop/restart (comma-separated
# container names). Default protects the dashboard + nginx so you can't lock
# yourself out. Server-side backstop; the UI also hides these controls.
PROTECTED_CONTAINERS=dashboard,home-nginx

# Vite dev-proxy upstream — only used by `npm run dev`. Lets you point the
# proxy at an alternate backend port. Ignored in production (same-origin).
DASHBOARD_API_TARGET=http://localhost:8000

# Library service (mounted into dashboard compose)
LIBRARY_BOOK_DIR=/mnt/backup/books
LIBRARY_SECRET_KEY=

# Calendar service
CALENDAR_SECRET_KEY=
