[Unit]
Description=Renew the home stack's Tailscale TLS certificate
Documentation=file:///home/idego/Projects/dashboard/README.md
Wants=network-online.target tailscaled.service
After=network-online.target tailscaled.service

[Service]
Type=oneshot
# Adjust to wherever the dashboard repo is cloned on the Pi.
ExecStart=/home/idego/Projects/dashboard/scripts/tailscale-cert.sh
Environment=SUDO_USER=idego
