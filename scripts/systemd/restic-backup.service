[Unit]
Description=Home-stack restic backup to GCS
Documentation=file:///home/idego/Projects/dashboard/docs/BACKUPS.md
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/restic/home-stack.env
# Adjust to wherever the dashboard repo is cloned on the Pi. STACK_ROOT is
# derived from this path (the parent dir), so the script finds the sibling
# library/, calendar/ and tapes/ checkouts automatically.
ExecStart=/home/idego/Projects/dashboard/scripts/restic-backup.sh
# Be a good citizen on the Pi — backups are not latency-sensitive.
Nice=10
IOSchedulingClass=idle
# Mild hardening; the script needs to read app data + write the staging dir.
ProtectSystem=full
PrivateTmp=true
