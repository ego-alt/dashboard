# Restic backup credentials + config for the home stack.
#
# Install this as /etc/restic/home-stack.env (root-owned, chmod 600) — NOT in
# the git repo. restic-backup.service loads it as its EnvironmentFile.
#
#   sudo install -m 600 /dev/stdin /etc/restic/home-stack.env < this-file
#   sudo chmod 600 /etc/restic/home-stack.env

# --- restic repository (Google Cloud Storage, native gs: backend) ------------
# Bucket must already exist. The path after the bucket is the repo prefix.
RESTIC_REPOSITORY=gs:YOUR_BUCKET_NAME:/home-pi

# File holding the restic repo password (root-only, chmod 600). Generate with:
#   openssl rand -base64 32 | sudo tee /etc/restic/password >/dev/null
#   sudo chmod 600 /etc/restic/password
# KEEP A COPY OFFLINE — without it the backup is unrecoverable.
RESTIC_PASSWORD_FILE=/etc/restic/password

# --- GCS auth ----------------------------------------------------------------
# Service account with the "Storage Object Admin" role on the bucket.
GOOGLE_PROJECT_ID=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=/etc/restic/gcs-sa.json

# --- paths (override only if your layout differs from docker-compose.yml) -----
LIBRARY_BOOK_DIR=/mnt/backup/books
MUSIC_HOST_DIR=/mnt/backup/tapes

# Run-status file for the dashboard "Backups" card. Defaults to
# /var/lib/home-stack-backup-status/status.json, which already matches the
# dashboard's read-only mount in docker-compose.yml — leave unset unless you
# relocate it (then update BACKUP_STATUS_DIR in compose to match).
#BACKUP_STATUS_FILE=/var/lib/home-stack-backup-status/status.json

# --- retention ---------------------------------------------------------------
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=6

# restic local cache (speeds up repeated runs; safe to delete).
RESTIC_CACHE_DIR=/var/cache/restic

# Set to 1 to run `restic check` after each backup (extra GCS egress; a weekly
# check is usually enough — see docs/BACKUPS.md).
RUN_CHECK=0
